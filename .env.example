# ==============================================================================
# PeerSpace — Environment Configuration Template
# NOTE: Copy this file to .env for local development. Never commit .env to source control.
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
# Local default for development: mongodb://127.0.0.1:27017/peerspace_feedback
MONGODB_URI=mongodb://127.0.0.1:27017/peerspace_feedback

# Frontend Client Origin for CORS
CORS_ORIGIN=http://localhost:5173

# Server Session Secret (Use a secure, high-entropy 64+ char random string in production)
SESSION_SECRET=your-secure-session-secret-change-in-production-min-32-chars

# One-time Server-side Administrator Provisioning Secret (Required for CLI script)
ADMIN_PROVISION_SECRET=your-secure-admin-provision-secret-min-32-chars

# Email Service Configuration — Resend HTTP API over HTTPS (Primary)
# Required for production (e.g., Render Free tier blocks outbound SMTP ports 25, 465, 587).
# Note: Sending to arbitrary student addresses in production requires a verified domain in Resend.
# For initial testing without a custom domain, onboarding@resend.dev can be used as the sender.
RESEND_API_KEY=re_your_resend_api_key_placeholder
RESEND_FROM=PeerSpace <onboarding@resend.dev>
APP_URL=http://localhost:5173

# Deprecated Email Service Configuration (SMTP Fallback)
# Used only if RESEND_API_KEY is not configured.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.edu
# SMTP_PASS=your-smtp-password
# SMTP_FROM=PeerSpace <no-reply@peerspace.edu>

# Client-side Environment Variables (Vite)
VITE_API_URL=http://localhost:5001
